NODE_ENV=development
SERVER_PORT=3000

# PostgreSQL — matches docker-compose defaults
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ledger
DB_PASSWORD=ledger
DB_DATABASE=ledger
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# MongoDB — matches docker-compose defaults
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/ledger?authSource=admin
# Database in the same MongoDB instance where the validators service writes canonical data
MONGO_ETL_DB=rules_engine_v3

# RabbitMQ — matches docker-compose defaults
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Audit logs
AUDIT_LOG_DIR=./logs/audit

# Domain config
USINA_PARTY_ID=party-usina
