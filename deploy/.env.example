# Copy to deploy/.env and fill with REAL secrets before deploying. Never commit deploy/.env.

# ── Required ──────────────────────────────────────────────────────────────────

# Shared service token: Treasury -> Ledger submit endpoint. The Ledger's submit endpoint fails
# closed when this is empty, so a blank value means nothing can be recorded.
# Generate: openssl rand -hex 32
LEDGER_SUBMIT_TOKEN=

# CFO / viewer login passwords for the Treasury User App.
AUTH_MANAGER_PASSWORD=
AUTH_VIEWER_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────

# The usina's canonical party id (must match the Ledger's book).
USINA_PARTY_ID=party-usina

# Fuso horário em que o livro é mantido. Decide como uma data SEM offset é lida — uma data digitada
# como "2026-09-14" significa esse dia aqui, não em UTC. Os instantes continuam gravados em UTC.
TZ=America/Sao_Paulo

# Where Treasury is published on the host. The default binds to loopback only — reach it through an
# SSH tunnel (`ssh -L 4000:127.0.0.1:4000 user@host`) or put the `tls` profile in front of it.
# Set BIND_ADDRESS=0.0.0.0 only if something else on the host already terminates TLS.
BIND_ADDRESS=127.0.0.1
TREASURY_PORT=4000

# Only read by the `tls` profile: the public domain Caddy provisions a certificate for.
# Point its A record at this host's public IP first.
SITE_ADDRESS=finance.example.com
