{
  "name": "treasury",
  "version": "0.1.0",
  "description": "User App — human-facing interaction/intent context for the Ledger ecosystem",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/presentation/web && cp -r src/presentation/web/client dist/presentation/web/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.10.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.3.3",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
