{
  "name": "treasury",
  "version": "0.1.0",
  "description": "User App — human-facing interaction/intent context for the Ledger ecosystem",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:client": "npm --prefix src/presentation/web/client run dev",
    "start": "node dist/index.js",
    "build": "tsc && npm run build:client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run",
    "test:client": "npm --prefix src/presentation/web/client test",
    "test:watch": "vitest",
    "seed:directory": "tsx src/infra/seeding/run-seed.ts",
    "build:client": "npm --prefix src/presentation/web/client ci && npm --prefix src/presentation/web/client run build && mkdir -p dist/presentation/web/client && cp -R src/presentation/web/client/dist/. dist/presentation/web/client/",
    "worker:insurance": "tsx src/infra/workers/producers/insurance-eligibility.ts",
    "consume:signals": "tsx src/infra/workers/consumers/register-signals.ts",
    "dev:async": "concurrently \"npm run worker:insurance\" \"npm run consume:signals\""
  },
  "dependencies": {
    "amqplib": "^2.3.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.3.3",
    "concurrently": "^10.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
