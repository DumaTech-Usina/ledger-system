{
  "name": "treasury",
  "version": "0.1.0",
  "description": "User App \u2014 human-facing interaction/intent context for the Ledger ecosystem",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:client": "npm --prefix src/presentation/web/client run dev",
    "start": "node dist/index.js",
    "build": "tsc && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:directory": "tsx src/infra/seeding/run-seed.ts",
    "build:client": "npm --prefix src/presentation/web/client ci && npm --prefix src/presentation/web/client run build && mkdir -p dist/presentation/web/client && cp -R src/presentation/web/client/dist/. dist/presentation/web/client/"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.10.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.3.3",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^10.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
