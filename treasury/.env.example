NODE_ENV=development
PORT=4000

# Read-only Ledger API, used later to display financial effects (no writes)
LEDGER_API_URL=http://localhost:3000

# How treasury talks to the Ledger:
#   simulate = in-memory fake Ledger for submit + reads (full create->dashboard loop; demo)
#   stub     = stubbed submit + static dashboard data (disconnected)
#   live     = real Ledger over HTTP for BOTH submit and reads (uses LEDGER_API_URL)
LEDGER_MODE=simulate
# Service token sent as Bearer on live submissions (must match the Ledger's expected token)
LEDGER_SUBMIT_TOKEN=

# The usina's party id used when mapping an intent to a Ledger candidate
USINA_PARTY_ID=party-usina

# Auth / sessions
SESSION_TTL_HOURS=12
# Seed credentials — CHANGE THESE IN PRODUCTION
AUTH_MANAGER_PASSWORD=treasury
AUTH_VIEWER_PASSWORD=viewer

# Party Directory storage:
#   memory = volatile (tests, and exercising resolution) — never for issuing PartyIds
#   sqlite = durable, required before any PartyId reaches a production Ledger
# Unset: sqlite with LEDGER_MODE=live, memory otherwise. memory is refused with LEDGER_MODE=live.
# PARTY_DIRECTORY_MODE=sqlite
# PARTY_DB_FILE=./data/treasury.db

# Who holds curation of the party registry, by username, comma-separated (REQ-402)
CURATOR_USERNAMES=cfo

# Intents, audit and conversation log. Unset: sqlite with LEDGER_MODE=live, memory otherwise.
# memory is refused with LEDGER_MODE=live, because the audit must outlive a restart (REQ-801).
# OPERATIONS_STORE_MODE=sqlite
# OPERATIONS_DB_FILE=./data/treasury.db

# Insurance system integration (round 15). The producer reads the insurance API and publishes to the
# broker; the consumer registers each message as a signal. Run with `npm run worker:insurance` and
# `npm run consume:signals`. The broker runs on its own server: point RABBITMQ_URL at it.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# INSURANCE_API_URL=http://localhost:3100
# INSURANCE_API_EMAIL=
# INSURANCE_API_PASSWORD=
# INSURANCE_POLL_MINUTES=5
